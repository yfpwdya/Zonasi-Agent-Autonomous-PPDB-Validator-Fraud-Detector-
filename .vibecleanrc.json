{
  "maxFiles": 500,
  "profile": "app",
  "ignore": [
    "next.config.ts",
    "postcss.config.mjs",
    "tailwind.config.ts",
    "src/proxy.ts",
    "src/server/agent/decide.test.ts"
  ],
  "rules": {
    "naming": true,
    "patterns": true,
    "leftovers": true,
    "security": true,
    "frameworks": true,
    "dependencies": true,
    "deadcode": false,
    "errorhandling": true,
    "tsquality": true
  },
  "allowedPatterns": {
    "httpClient": "axios",
    "asyncStyle": "async-await"
  }
}

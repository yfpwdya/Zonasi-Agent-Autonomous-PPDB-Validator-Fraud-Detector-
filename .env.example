# Copy this file to .env.local and fill in values locally. Never commit real credentials.

# Database connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key

# Document scanner provider (server-side only)
GEMINI_API_KEY=your-server-api-key
